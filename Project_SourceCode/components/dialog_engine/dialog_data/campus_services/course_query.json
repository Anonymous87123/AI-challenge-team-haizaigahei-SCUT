{
  "dialog_type": "course_query",
  "description": "课程查询对话场景",
  "version": "3.0",
  "trigger_keywords": [
    "课程", "课表", "上课", "课程表", "时间表",
    "今天课", "明天课", "本周课", "下周课",
    "课程安排", "上课时间", "上课地点", "教室",
    "教学楼", "理科楼", "文科楼", "工科楼",
    "查询课程", "查看课程", "什么课", "有课吗",
    "第几节课", "几节课", "几点上课", "在哪里上课",
    "课程信息", "课程详情", "课程介绍",
    "选课", "退课", "换课", "补课",
    "调课", "停课", "课程通知"
  ],
  "intents": {
    "ask_schedule": {
      "description": "询问课程表",
      "required_entities": [],
      "optional_entities": ["time_range", "course_name"],
      "response_templates": [
        "正在查询{time_range}的课程安排...",
        "📅 让我看看{time_range}有什么课...",
        "好的，查询{time_range}的课表...",
        "查询中...{time_range}的课程安排"
      ],
      "sample_dialogues": [
        {
          "user": "今天有什么课程？",
          "ai": "你今天的课程安排如下：\n1-2节：高等数学（理科楼A301）\n3-4节：大学英语（文科楼B202）\n7-8节：计算机导论（工科楼C101）"
        },
        {
          "user": "明天有高数课吗？",
          "ai": "明天上午1-2节有高等数学课程，在理科楼A301教室。"
        }
      ]
    },
    "query_course": {
      "description": "查询课程信息",
      "required_entities": [],
      "optional_entities": ["course_name", "location"],
      "response_templates": [
        "正在查询{course_name}的信息...",
        "让我查找{course_name}的相关信息...",
        "🔍 正在搜索{course_name}...",
        "好的，查找{course_name}的详细信息..."
      ],
      "sample_dialogues": [
        {
          "user": "高数课的教室在哪里？",
          "ai": "高等数学课程在理科楼A301教室。每周一、三、五上午1-2节上课。"
        },
        {
          "user": "计算机课什么时候上课？",
          "ai": "计算机导论课程安排：\n时间：每周二、四下午7-8节\n地点：工科楼C101教室"
        }
      ]
    }
  },
  "entity_examples": {
    "time_range": [
      "今天", "明天", "后天",
      "本周", "下周", "本周一",
      "明天上午", "今天下午",
      "这周", "下周"
    ],
    "course_name": [
      "高数", "数学", "高等数学",
      "英语", "大学英语", "大英",
      "计算机", "编程", "数据结构",
      "物理", "化学", "生物",
      "思修", "马原"
    ],
    "location": [
      "理科楼A301", "文科楼B202",
      "工科楼C101", "教学楼",
      "实验室", "机房", "图书馆"
    ]
  }
}